# ─────────────────────────────────────────────────────────────────────────────
# TenderMatch Backend — Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local dev: mongodb://localhost:27018 | Docker: mongodb://mongodb:27017
MONGODB_URI=mongodb://localhost:27018
DATABASE_NAME=tendermatch

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_A_64_CHAR_RANDOM_HEX_SECRET
JWT_ALGORITHM=HS256
# Short-lived access token (minutes). Use 15 for production.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev: redis://localhost:6380/0 | Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6380/0

# ── LLM (Groq) ───────────────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY

# ── Email Notifications (SMTP) ────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# Use a Gmail App Password (not your account password)
# Guide: https://support.google.com/accounts/answer/185833
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
FROM_EMAIL=no-reply@tendermatch.com

# ── File Uploads ──────────────────────────────────────────────────────────────
# Local path for storing uploaded PDFs
UPLOAD_DIR=uploads

# ── Frontend URL (used in email links) ───────────────────────────────────────
# Production: https://app.tendermatch.com | Dev: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── CORS Allowed Origins ──────────────────────────────────────────────────────
# Comma-separated list. Keep restrictive in production.
# ALLOWED_ORIGINS=https://app.tendermatch.com

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Phase 2: PostgreSQL (Primary Relational Store) ────────────────────────────
# Local dev: postgresql+asyncpg://tendermatch:changeme@localhost:5433/tendermatch
# Docker:    postgresql+asyncpg://tendermatch:changeme@postgres:5432/tendermatch
POSTGRES_URI=postgresql+asyncpg://tendermatch:changeme@localhost:5433/tendermatch
POSTGRES_DB=tendermatch
POSTGRES_USER=tendermatch
POSTGRES_PASSWORD=changeme
# Connection pool settings
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ── External Scraping APIs (Phase 5) ─────────────────────────────────────────
BIDASSIST_API_URL=https://api.example-bidassist.com
BIDASSIST_API_KEY=YOUR_BIDASSIST_KEY
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_KEY

# ── Vendor Document Auto-Fill Pipeline (Phase 6) ─────────────────────────────
# LLM model used for multi-chunk vendor document structuring via Groq.
# Must match the model name accepted by the Groq API.
VENDOR_EXTRACTION_MODEL=llama-3.3-70b-versatile

# Maximum number of characters per chunk sent to the LLM.
# Larger chunks = fewer API calls but higher token cost per call.
VENDOR_EXTRACTION_CHUNK_SIZE=2000

# Overlap between consecutive chunks (characters). Preserves context across splits.
VENDOR_EXTRACTION_CHUNK_OVERLAP=200

# Maximum concurrent Groq requests during multi-chunk extraction.
# Prevents rate-limit storms on large PDFs (300-page = ~300 chunks).
# Capped to 10 by default; increase only if your Groq tier supports higher throughput.
VENDOR_EXTRACTION_GROQ_CONCURRENCY=10

# Maximum PDF file size accepted by POST /upload/vendor (in MB).
# Vendor documents can be larger than tenders; default is 50 MB.
VENDOR_UPLOAD_MAX_SIZE_MB=50
